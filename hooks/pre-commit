#!/bin/sh
# Runs the vault format linter before a commit.
#
# Install: git config core.hooksPath hooks
# Bypass:  git commit --no-verify
#
# Checks the working tree, not the staged snapshot. Inspecting staged content exactly
# would need a stash, and when staged and unstaged changes overlap in one file the pop
# conflicts and leaves markers in the user's work. Breaking someone's working tree over
# a lint run is not worth it, so we check the working tree and warn when the two differ.

set -e

# Only run for commits touching Markdown or the vault config.
# Without -c core.quotepath=false, git quotes non-ASCII filenames and the pattern misses.
if ! git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR \
  | grep -qE '(\.md$|^\.kb\.yaml$)'; then
  exit 0
fi

command -v bun >/dev/null 2>&1 || {
  echo "pre-commit: bun not found, skipping lint" >&2
  exit 0
}

KB_LINT="${KB_PLUGIN_DIR:-$HOME/dev/kb}/lib/lint.ts"
[ -f "$KB_LINT" ] || {
  echo "pre-commit: kb linter not found, skipping ($KB_LINT)" >&2
  exit 0
}

# Warn when what we check differs from what gets committed.
if ! git diff --quiet -- '*.md' .kb.yaml 2>/dev/null; then
  echo "pre-commit: unstaged changes present; checking the working tree" >&2
fi

bun "$KB_LINT"
