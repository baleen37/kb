#!/bin/sh
# vault Markdown 형식 린터를 커밋 전에 돌린다.
#
# 설치: kb 플러그인이 vault에 심는다. 수동이면 git config core.hooksPath hooks
# 우회: git commit --no-verify
#
# 작업 트리를 검사한다. staged 스냅샷만 정확히 보려면 stash가 필요한데,
# staged/unstaged가 같은 파일에 겹치면 pop이 충돌해 작업 파일에 마커를 남긴다.
# 린트 하나 때문에 남의 작업을 깨뜨릴 이유가 없어서 작업 트리 검사로 둔다.
# 대신 둘이 다르면 경고만 띄운다.

set -e

# Markdown이나 vault 설정이 걸린 커밋만 검사한다.
# -c core.quotepath=false 없이는 한글 파일명이 인용돼 파일명 패턴 검사가 어긋난다.
if ! git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR \
  | grep -qE '(\.md$|^\.kb\.yaml$)'; then
  exit 0
fi

command -v bun >/dev/null 2>&1 || {
  echo "pre-commit: bun이 없어 린트를 건너뛴다" >&2
  exit 0
}

KB_LINT="${KB_PLUGIN_DIR:-$HOME/dev/kb}/lib/lint.ts"
[ -f "$KB_LINT" ] || {
  echo "pre-commit: kb 린터를 찾지 못해 건너뛴다 ($KB_LINT)" >&2
  exit 0
}

# 검사 대상과 커밋 대상이 어긋날 수 있는 상황을 알린다
if ! git diff --quiet -- '*.md' .kb.yaml 2>/dev/null; then
  echo "pre-commit: staged 되지 않은 변경이 있다. 작업 트리 기준으로 검사한다" >&2
fi

bun "$KB_LINT"
